# Database (Local embedded postgres or Supabase)
# For Supabase:
# DATABASE_URL = Connection string with pooling (Transaction mode, port 6543)
# DIRECT_URL = Direct connection string (port 5432)
DATABASE_URL="postgresql://chat_user:chat_password@localhost:5432/chat_db?schema=public"
DIRECT_URL="postgresql://chat_user:chat_password@localhost:5432/chat_db?schema=public"

# Backend server
PORT=5000
JWT_SECRET="your-super-secret-jwt-key"
NODE_ENV=development

# Optional Redis URL (if omitted, falls back to in-memory cache)
# REDIS_URL="redis://localhost:6379"
